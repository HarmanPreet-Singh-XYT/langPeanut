# langpeanut-cloud .env — copy this to .env and fill in values before deploying.
# NEVER commit .env to git.

# 32-byte hex master key for encrypting BYO API credentials at rest.
# Generate with: ./langpeanut-cloud keygen
MASTER_KEY=

# GitHub App configuration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/data/github-app.pem
GITHUB_WEBHOOK_SECRET=

# GitHub App OAuth (user login) — found on the App's settings page under
# "OAuth" / "Client secrets". Distinct from GITHUB_APP_ID + private key above,
# which authenticate the App itself for installation tokens.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Public base URL of this deployment, used to build the OAuth callback URL
# (must exactly match an "Authorization callback URL" configured on the App).
# e.g. https://app.langpeanut.ai or http://localhost:8080 for local dev.
PUBLIC_BASE_URL=http://localhost:8080

# 32-byte hex key used to sign session cookies (HMAC-SHA256).
# Generate with: ./langpeanut-cloud keygen
SESSION_SECRET=

# Optional overrides (defaults shown)
# LISTEN_ADDR=:8080
# DATABASE_PATH=/data/langpeanut.db
# MIRRORS_DIR=/data/mirrors
# JOBS_DIR=/data/jobs
# RUNNER_IMAGE=langpeanut-runner:latest
