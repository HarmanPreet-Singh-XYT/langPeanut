# Caddyfile — langpeanut-cloud reverse proxy
# Default binds to HTTP :80 for immediate VPS/staging testing.
# To enable automatic Let's Encrypt HTTPS, replace `:80` with your domain:
#   e.g. `langpeanut.example.com { ... }`

:80 {
    reverse_proxy app:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    encode gzip
}
