# ==============================================================================
# langPeanut Cloud — Environment Configuration Template
# ==============================================================================

# 32-byte hex master key for AES-256-GCM credential encryption at rest
# Generate with: openssl rand -hex 32
MASTER_KEY=your_64_character_hex_master_key_here

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/data/github-app.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub OAuth Login (User-to-Server)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Optional LLM API Keys (Can also be set in Dashboard UI under Settings -> API Credentials)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPL_API_KEY=
HF_TOKEN=

# Runtime Service Settings
LISTEN_ADDR=:8080
DATABASE_PATH=/data/langpeanut.db
MIRRORS_DIR=/data/mirrors
JOBS_DIR=/data/jobs
RUNNER_IMAGE=langpeanut-runner:latest

# Optional: Google Cloud Pub/Sub durable webhook intake.
# Leave GCP_PROJECT_ID unset to process GitHub webhooks synchronously
# in-process (no GCP dependency, default for local dev).
# When set, the server publishes verified webhook deliveries to
# PUBSUB_WEBHOOK_TOPIC and a subscriber goroutine consumes them from
# PUBSUB_WEBHOOK_SUBSCRIPTION. Both must already exist — create with:
#   gcloud pubsub topics create langpeanut-webhooks
#   gcloud pubsub subscriptions create langpeanut-webhooks-server \
#     --topic=langpeanut-webhooks --ack-deadline=30
# The VM's service account needs roles/pubsub.publisher and
# roles/pubsub.subscriber on the project (or the topic/subscription).
GCP_PROJECT_ID=
PUBSUB_WEBHOOK_TOPIC=langpeanut-webhooks
PUBSUB_WEBHOOK_SUBSCRIPTION=langpeanut-webhooks-server
